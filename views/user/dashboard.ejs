<% layout("/layouts/boilerplate") %>

<style>
  .user-container {
    display: flex;
    min-height: 100vh;
    background: var(--bg-dark);
  }

  /* Hide footer in dashboard */
  footer {
    display: none !important;
  }

  /* Sidebar Styles */
  .user-sidebar {
    width: 280px;
    background: var(--primary-color);
    padding: 0;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
    z-index: 1000;
  }

  .sidebar-header {
    padding: 30px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .user-profile {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .user-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 3px solid var(--accent-color);
    object-fit: cover;
  }

  .user-info h4 {
    color: var(--text-light);
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .user-info p {
    color: #94a3b8;
    margin: 5px 0 0 0;
    font-size: 0.9rem;
  }

  .sidebar-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-menu li {
    margin: 0;
  }

  .sidebar-menu a {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px 20px;
    color: #cbd5e1;
    text-decoration: none;
    transition: all 0.3s ease;
    border-left: 3px solid transparent;
  }

  .sidebar-menu a:hover,
  .sidebar-menu li.active a {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    border-left-color: var(--accent-color);
  }

  .sidebar-menu i {
    width: 20px;
    text-align: center;
  }

  /* Main Content */
  .main-content {
    flex: 1;
    margin-left: 280px;
    padding: 30px;
  }

  .dashboard-header {
    margin-bottom: 30px;
  }

  .dashboard-title {
    color: var(--text-light);
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 10px 0;
  }

  .dashboard-subtitle {
    color: #94a3b8;
    font-size: 1.1rem;
    margin: 0;
  }

  /* Stats Cards */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    padding: 25px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.08);
  }

  .stat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
  }

  .stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: white;
  }

  .stat-icon.bookings {
    background: linear-gradient(135deg, var(--accent-color), #0891b2);
  }

  .stat-icon.reviews {
    background: linear-gradient(135deg, #f59e0b, #d97706);
  }

  .stat-icon.spent {
    background: linear-gradient(135deg, #10b981, #059669);
  }

  .stat-icon.profile {
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-light);
    margin: 0;
  }

  .stat-label {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 5px 0 0 0;
  }

  /* Content Sections */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 40px;
  }

  .content-section {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    padding: 25px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .section-title {
    color: var(--text-light);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0;
  }

  .section-link {
    color: var(--accent-color);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .section-link:hover {
    color: var(--primary-light);
  }

  /* Recent Bookings */
  .booking-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .booking-item:last-child {
    border-bottom: none;
  }

  .booking-image {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
  }

  .booking-info h4 {
    color: var(--text-light);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 5px 0;
  }

  .booking-info p {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0;
  }

  .booking-status {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
    margin-left: auto;
  }

  .booking-status.pending {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
  }

  .booking-status.confirmed {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
  }

  .booking-status.cancelled {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  /* Available Listings */
  .listings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .listing-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .listing-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.08);
  }

  .listing-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .listing-content {
    padding: 20px;
  }

  .listing-title {
    color: var(--text-light);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 8px 0;
  }

  .listing-location {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 0 0 15px 0;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .listing-price {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
  }

  .price {
    color: var(--accent-color);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .price-period {
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .book-btn {
    width: 100%;
    padding: 12px;
    background: linear-gradient(135deg, var(--accent-color), var(--primary-light));
    color: white;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .book-btn:hover {
    background: linear-gradient(135deg, #0891b2, #3b82f6);
    transform: translateY(-2px);
  }

  /* Recent Activity */
  .activity-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .activity-item:last-child {
    border-bottom: none;
  }

  .activity-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1rem;
  }

  .activity-content {
    flex: 1;
  }

  .activity-message {
    color: var(--text-light);
    font-size: 0.9rem;
    margin: 0 0 5px 0;
  }

  .activity-time {
    color: #94a3b8;
    font-size: 0.8rem;
    margin: 0;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .user-sidebar {
      width: 100%;
      position: relative;
      height: auto;
    }

    .main-content {
      margin-left: 0;
      padding: 20px;
    }

    .content-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .listings-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="user-container">
  <!-- User Sidebar -->
  <nav class="user-sidebar">
    <div class="sidebar-header">
      <div class="user-profile">
        <img src="https://via.placeholder.com/60" alt="User" class="user-avatar">
        <div class="user-info">
          <h4><%= user.username %></h4>
          <p><%= user.email %></p>
        </div>
      </div>
    </div>
    <ul class="sidebar-menu">
      <li class="active">
        <a href="/user/dashboard">
          <i class="fas fa-tachometer-alt"></i>
          <span>Dashboard</span>
        </a>
      </li>
      <li>
        <a href="/user/bookings">
          <i class="fas fa-calendar-check"></i>
          <span>My Bookings</span>
        </a>
      </li>
      <li>
        <a href="/user/profile">
          <i class="fas fa-user"></i>
          <span>Profile</span>
        </a>
      </li>
      <li>
        <a href="/logout">
          <i class="fas fa-sign-out-alt"></i>
          <span>Logout</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Main Content -->
  <main class="main-content">
    <div class="dashboard-header">
      <h1 class="dashboard-title">Welcome back, <%= user.firstName || user.username %>!</h1>
      <p class="dashboard-subtitle">Manage your bookings and discover new places to stay</p>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-icon bookings">
            <i class="fas fa-calendar-check"></i>
          </div>
        </div>
        <h3 class="stat-value"><%= userBookings %></h3>
        <p class="stat-label">Total Bookings</p>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-icon spent">
            <i class="fas fa-dollar-sign"></i>
          </div>
        </div>
        <h3 class="stat-value">$<%= totalSpent %></h3>
        <p class="stat-label">Total Spent</p>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-icon profile">
            <i class="fas fa-user"></i>
          </div>
        </div>
        <h3 class="stat-value"><%= user.firstName ? 'Complete' : 'Incomplete' %></h3>
        <p class="stat-label">Profile Status</p>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="content-grid">
      <!-- Recent Bookings -->
      <div class="content-section">
        <div class="section-header">
          <h2 class="section-title">Recent Bookings</h2>
          <a href="/user/bookings" class="section-link">View All</a>
        </div>
        
        <% if (userBookingsData && userBookingsData.length > 0) { %>
          <% userBookingsData.slice(0, 3).forEach(booking => { %>
            <div class="booking-item">
              <img src="<%= booking.listing.image ? booking.listing.image.url : 'https://via.placeholder.com/60' %>" 
                   alt="<%= booking.listing.title %>" class="booking-image">
              <div class="booking-info">
                <h4><%= booking.listing.title %></h4>
                <p><%= booking.checkIn.toLocaleDateString() %> - <%= booking.checkOut.toLocaleDateString() %></p>
              </div>
              <span class="booking-status <%= booking.status %>"><%= booking.status %></span>
            </div>
          <% }); %>
        <% } else { %>
          <p style="color: #94a3b8; text-align: center; padding: 20px;">No bookings yet. Start exploring!</p>
        <% } %>
      </div>

      <!-- Recent Activity -->
      <div class="content-section">
        <div class="section-header">
          <h2 class="section-title">Recent Activity</h2>
        </div>
        
        <% if (recentActivity && recentActivity.length > 0) { %>
          <% recentActivity.forEach(activity => { %>
            <div class="activity-item">
              <div class="activity-icon">
                <i class="fas fa-<%= activity.icon %>"></i>
              </div>
              <div class="activity-content">
                <p class="activity-message"><%= activity.message %></p>
                <p class="activity-time"><%= activity.time %></p>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p style="color: #94a3b8; text-align: center; padding: 20px;">No recent activity</p>
        <% } %>
      </div>
    </div>

    <!-- Available Listings -->
    <div class="content-section">
      <div class="section-header">
        <h2 class="section-title">Available Listings</h2>
        <a href="/listings" class="section-link">View All</a>
      </div>
      
      <div class="listings-grid">
        <% if (availableListings && availableListings.length > 0) { %>
          <% availableListings.forEach(listing => { %>
            <div class="listing-card">
              <img src="<%= listing.image ? listing.image.url : 'https://via.placeholder.com/300x200' %>" 
                   alt="<%= listing.title %>" class="listing-image">
              <div class="listing-content">
                <h3 class="listing-title"><%= listing.title %></h3>
                <p class="listing-location">
                  <i class="fas fa-map-marker-alt"></i>
                  <%= listing.location %>, <%= listing.country %>
                </p>
                <div class="listing-price">
                  <span class="price">$<%= listing.price %></span>
                  <span class="price-period">per night</span>
                </div>
                <button class="book-btn" onclick="openBookingModal('<%= listing._id %>', '<%= listing.title %>', <%= listing.price %>)">
                  <i class="fas fa-calendar-plus"></i> Book Now
                </button>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p style="color: #94a3b8; text-align: center; padding: 20px; grid-column: 1 / -1;">No listings available at the moment</p>
        <% } %>
      </div>
    </div>
  </main>
</div>

<!-- Booking Modal -->
<div id="bookingModal" class="modal" style="display: none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Book Your Stay</h2>
      <span class="close">&times;</span>
    </div>
    <form id="bookingForm" action="/booking" method="POST">
      <input type="hidden" id="listingId" name="listingId" value="">
      
      <div class="form-group">
        <label for="checkIn">Check-in Date</label>
        <input type="date" id="checkIn" name="checkIn" required>
      </div>
      
      <div class="form-group">
        <label for="checkOut">Check-out Date</label>
        <input type="date" id="checkOut" name="checkOut" required>
      </div>
      
      <div class="form-group">
        <label for="guests">Number of Guests</label>
        <select id="guests" name="guests" required>
          <option value="">Select guests</option>
          <option value="1">1 Guest</option>
          <option value="2">2 Guests</option>
          <option value="3">3 Guests</option>
          <option value="4">4 Guests</option>
          <option value="5">5+ Guests</option>
        </select>
      </div>
      
      <div class="form-group">
        <label for="specialRequests">Special Requests (Optional)</label>
        <textarea id="specialRequests" name="specialRequests" rows="3" placeholder="Any special requests or notes..."></textarea>
      </div>
      
      <div class="form-group">
        <label>Total Price</label>
        <div id="totalPrice" class="total-price">$0</div>
      </div>
      
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeBookingModal()">Cancel</button>
        <button type="submit" class="btn-confirm">Confirm Booking</button>
      </div>
    </form>
  </div>
</div>

<style>
  .modal {
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(5px);
  }

  .modal-content {
    background: var(--primary-color);
    margin: 5% auto;
    padding: 0;
    border-radius: 15px;
    width: 90%;
    max-width: 500px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modal-header h2 {
    color: var(--text-light);
    margin: 0;
    font-size: 1.5rem;
  }

  .close {
    color: #94a3b8;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .close:hover {
    color: var(--text-light);
  }

  .modal form {
    padding: 30px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    color: var(--text-light);
    font-weight: 500;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-light);
    font-size: 1rem;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-color);
  }

  .total-price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-color);
    padding: 15px;
    background: rgba(6, 182, 212, 0.1);
    border-radius: 8px;
    text-align: center;
  }

  .modal-actions {
    display: flex;
    gap: 15px;
    margin-top: 30px;
  }

  .btn-cancel,
  .btn-confirm {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-cancel {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
  }

  .btn-cancel:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .btn-confirm {
    background: linear-gradient(135deg, var(--accent-color), var(--primary-light));
    color: white;
  }

  .btn-confirm:hover {
    background: linear-gradient(135deg, #0891b2, #3b82f6);
  }
</style>

<script>
function openBookingModal(listingId, listingTitle, pricePerNight) {
  document.getElementById('listingId').value = listingId;
  document.getElementById('bookingModal').style.display = 'block';
  document.body.style.overflow = 'hidden';
  
  // Set minimum date to today
  const today = new Date().toISOString().split('T')[0];
  document.getElementById('checkIn').min = today;
  document.getElementById('checkOut').min = today;
  
  // Update total price when dates or guests change
  updateTotalPrice();
}

function closeBookingModal() {
  document.getElementById('bookingModal').style.display = 'none';
  document.body.style.overflow = 'auto';
  document.getElementById('bookingForm').reset();
}

// Close modal when clicking outside
window.onclick = function(event) {
  const modal = document.getElementById('bookingModal');
  if (event.target === modal) {
    closeBookingModal();
  }
}

// Close modal with X button
document.querySelector('.close').onclick = closeBookingModal;

function updateTotalPrice() {
  const checkIn = new Date(document.getElementById('checkIn').value);
  const checkOut = new Date(document.getElementById('checkOut').value);
  const guests = parseInt(document.getElementById('guests').value) || 0;
  
  if (checkIn && checkOut && guests > 0) {
    const nights = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));
    if (nights > 0) {
      const pricePerNight = 100; // This should come from the listing data
      const total = pricePerNight * nights * guests;
      document.getElementById('totalPrice').textContent = `$${total}`;
    } else {
      document.getElementById('totalPrice').textContent = '$0';
    }
  } else {
    document.getElementById('totalPrice').textContent = '$0';
  }
}

// Add event listeners for price calculation
document.getElementById('checkIn').addEventListener('change', updateTotalPrice);
document.getElementById('checkOut').addEventListener('change', updateTotalPrice);
document.getElementById('guests').addEventListener('change', updateTotalPrice);

// Form validation
document.getElementById('bookingForm').addEventListener('submit', function(e) {
  const checkIn = new Date(document.getElementById('checkIn').value);
  const checkOut = new Date(document.getElementById('checkOut').value);
  
  if (checkOut <= checkIn) {
    e.preventDefault();
    alert('Check-out date must be after check-in date.');
    return;
  }
  
  if (!document.getElementById('guests').value) {
    e.preventDefault();
    alert('Please select number of guests.');
    return;
  }
});
</script>