<% layout("/layouts/boilerplate") %>

<style>
  .user-container {
    display: flex;
    min-height: 100vh;
    background: var(--bg-dark);
  }

  /* Hide footer in dashboard */
  footer {
    display: none !important;
  }

  /* Sidebar Styles */
  .user-sidebar {
    width: 280px;
    background: var(--primary-color);
    padding: 0;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
    z-index: 1000;
  }

  .sidebar-header {
    padding: 30px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .user-profile {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .user-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 3px solid var(--accent-color);
    object-fit: cover;
  }

  .user-avatar-placeholder {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 3px solid var(--accent-color);
    background: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-light);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .booking-image-placeholder {
    width: 100%;
    height: 200px;
    background: var(--bg-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 2rem;
    border-radius: 8px 8px 0 0;
  }

  .user-info h4 {
    color: var(--text-light);
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .user-info p {
    color: #94a3b8;
    margin: 5px 0 0 0;
    font-size: 0.9rem;
  }

  .sidebar-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-menu li {
    margin: 0;
  }

  .sidebar-menu a {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px 20px;
    color: #cbd5e1;
    text-decoration: none;
    transition: all 0.3s ease;
    border-left: 3px solid transparent;
  }

  .sidebar-menu a:hover,
  .sidebar-menu li.active a {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    border-left-color: var(--accent-color);
  }

  .sidebar-menu i {
    width: 20px;
    text-align: center;
  }

  /* Main Content */
  .main-content {
    flex: 1;
    margin-left: 280px;
    padding: 30px;
  }

  .page-header {
    margin-bottom: 30px;
  }

  .page-title {
    color: var(--text-light);
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 10px 0;
  }

  .page-subtitle {
    color: #94a3b8;
    font-size: 1.1rem;
    margin: 0;
  }

  /* Bookings Grid */
  .bookings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 12px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .booking-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(15px);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    max-width: 330px;
    margin: 0 auto;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .booking-card:hover {
    transform: translateY(-8px) scale(1.02);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.08));
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    border-color: rgba(6, 182, 212, 0.5);
  }

  .booking-image {
    width: 100%;
    height: 120px;
    object-fit: cover;
    display: block;
  }

  .booking-content {
    padding: 15px;
  }

  .booking-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
  }

  .booking-title {
    color: var(--text-light);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .booking-status {
    padding: 8px 14px;
    border-radius: 25px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .booking-status.pending {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
  }

  .booking-status.confirmed {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
  }

  .booking-status.cancelled {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .booking-status.completed {
    background: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
  }

  .booking-details {
    margin-bottom: 20px;
  }

  .booking-detail {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .booking-detail i {
    width: 16px;
    color: var(--accent-color);
  }

  .booking-price {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    padding: 12px 16px;
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(6, 182, 212, 0.08));
    border-radius: 12px;
    border: 1px solid rgba(6, 182, 212, 0.2);
  }

  .price-label {
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .price-value {
    color: var(--accent-color);
    font-size: 1.4rem;
    font-weight: 800;
    text-shadow: 0 2px 4px rgba(6, 182, 212, 0.3);
  }

  .booking-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .btn-action {
    flex: 1;
    padding: 12px 16px;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    text-align: center;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .btn-view {
    background: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .btn-view:hover {
    background: rgba(59, 130, 246, 0.3);
    color: #60a5fa;
  }

  .btn-cancel {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .btn-cancel:hover {
    background: rgba(239, 68, 68, 0.3);
    color: #f87171;
  }

  .btn-edit {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .btn-edit:hover {
    background: rgba(245, 158, 11, 0.3);
    color: #fbbf24;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
  }

  .btn-cancel:hover {
    background: rgba(239, 68, 68, 0.3);
    color: #f87171;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #94a3b8;
  }

  .empty-state i {
    font-size: 4rem;
    margin-bottom: 20px;
    color: var(--accent-color);
  }

  .empty-state h3 {
    color: var(--text-light);
    margin-bottom: 10px;
  }

  .empty-state p {
    margin-bottom: 30px;
  }

  .btn-explore {
    display: inline-block;
    padding: 12px 30px;
    background: linear-gradient(135deg, var(--accent-color), var(--primary-light));
    color: white;
    text-decoration: none;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-explore:hover {
    background: linear-gradient(135deg, #0891b2, #3b82f6);
    transform: translateY(-2px);
    color: white;
    text-decoration: none;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .user-sidebar {
      width: 100%;
      position: relative;
      height: auto;
    }

    .main-content {
      margin-left: 0;
      padding: 20px;
    }

    .bookings-grid {
      grid-template-columns: 1fr;
    }

    .booking-actions {
      flex-direction: column;
    }
  }
</style>

<div class="user-container">
  <!-- User Sidebar -->
  <nav class="user-sidebar">
    <div class="sidebar-header">
      <div class="user-profile">
        <div class="user-avatar-placeholder">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <div class="user-info">
          <h4><%= user.username %></h4>
          <p><%= user.email %></p>
        </div>
      </div>
    </div>
    <ul class="sidebar-menu">
      <li>
        <a href="/user/dashboard">
          <i class="fas fa-tachometer-alt"></i>
          <span>Dashboard</span>
        </a>
      </li>
      <li class="active">
        <a href="/user/bookings">
          <i class="fas fa-calendar-check"></i>
          <span>My Bookings</span>
        </a>
      </li>
      <li>
        <a href="/user/profile">
          <i class="fas fa-user"></i>
          <span>Profile</span>
        </a>
      </li>
      <li>
        <a href="/logout">
          <i class="fas fa-sign-out-alt"></i>
          <span>Logout</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Main Content -->
  <main class="main-content">
    <div class="page-header">
      <h1 class="page-title">My Bookings</h1>
      <p class="page-subtitle">Manage your reservations and booking history</p>
    </div>

    <% if (bookings && bookings.length > 0) { %>
      <div class="bookings-grid">
        <% bookings.forEach(booking => { %>
          <div class="booking-card">
            <div class="booking-image-placeholder">
              <i class="fas fa-home"></i>
            </div>
            <div class="booking-content">
              <div class="booking-header">
                <h3 class="booking-title"><%= booking.listing.title %></h3>
                <% if (booking.status !== 'cancelled') { %>
                  <span class="booking-status <%= booking.status %>"><%= booking.status %></span>
                <% } %>
              </div>
              
              <div class="booking-details">
                <div class="booking-detail">
                  <i class="fas fa-map-marker-alt"></i>
                  <span><%= booking.listing.location %>, <%= booking.listing.country %></span>
                </div>
                <div class="booking-detail">
                  <i class="fas fa-calendar-alt"></i>
                  <span><%= booking.checkIn.toLocaleDateString() %> - <%= booking.checkOut.toLocaleDateString() %></span>
                </div>
                <div class="booking-detail">
                  <i class="fas fa-users"></i>
                  <span><%= booking.guests %> <%= booking.guests === 1 ? 'Guest' : 'Guests' %></span>
                </div>
                <div class="booking-detail">
                  <i class="fas fa-clock"></i>
                  <span>Booked on <%= booking.bookingDate.toLocaleDateString() %></span>
                </div>
                <% if (booking.specialRequests) { %>
                  <div class="booking-detail">
                    <i class="fas fa-comment"></i>
                    <span><%= booking.specialRequests %></span>
                  </div>
                <% } %>
              </div>

              <div class="booking-price">
                <span class="price-label">Total Price</span>
                <span class="price-value">$<%= booking.totalPrice %></span>
              </div>

              <div class="booking-actions">
                <% if (booking.status === 'pending' || booking.status === 'confirmed') { %>
                  <a href="/booking/<%= booking._id %>/edit" class="btn-action btn-edit">
                    <i class="fas fa-edit"></i> Edit
                  </a>
                  <button onclick="cancelBooking('<%= booking._id %>')" class="btn-action btn-cancel">
                    <i class="fas fa-times"></i> Cancel
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-calendar-times"></i>
        <h3>No Bookings Yet</h3>
        <p>You haven't made any bookings yet. Start exploring amazing places to stay!</p>
        <a href="/listings" class="btn-explore">
          <i class="fas fa-search"></i> Explore Listings
        </a>
      </div>
    <% } %>
  </main>
</div>

<script>
function cancelBooking(bookingId) {
  if (confirm('Are you sure you want to cancel this booking?')) {
    fetch(`/booking/${bookingId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => {
      if (response.ok) {
        location.reload();
      } else {
        alert('Failed to cancel booking. Please try again.');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('An error occurred. Please try again.');
    });
  }
}
</script>
