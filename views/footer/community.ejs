<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="community-header text-center mb-5">
                <h1 class="display-4 fw-bold text-light mb-3">
                    <i class="fas fa-heart me-3"></i>Community Impact
                </h1>
                <p class="lead text-muted">
                    Together, we can make a difference in communities around the world.
                </p>
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="community-card h-100">
                        <div class="card-body p-4">
                            <div class="community-icon mb-3">
                                <i class="fas fa-hands-helping fa-3x text-danger"></i>
                            </div>
                            <h4 class="card-title text-light">Disaster Relief</h4>
                            <p class="card-text text-muted">
                                Supporting communities affected by natural disasters and emergencies through temporary housing and relief efforts.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Emergency housing assistance</li>
                                <li><i class="fas fa-check text-success me-2"></i>Disaster response coordination</li>
                                <li><i class="fas fa-check text-success me-2"></i>Community rebuilding support</li>
                            </ul>
                            <a href="#" class="btn btn-danger">Learn More</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="community-card h-100">
                        <div class="card-body p-4">
                            <div class="community-icon mb-3">
                                <i class="fas fa-home fa-3x text-primary"></i>
                            </div>
                            <h4 class="card-title text-light">Support Refugees</h4>
                            <p class="card-text text-muted">
                                Providing safe and welcoming accommodations for refugees and displaced families seeking a new beginning.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Safe housing for refugees</li>
                                <li><i class="fas fa-check text-success me-2"></i>Integration support programs</li>
                                <li><i class="fas fa-check text-success me-2"></i>Community welcome initiatives</li>
                            </ul>
                            <a href="#" class="btn btn-primary">Get Involved</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="community-card h-100">
                        <div class="card-body p-4">
                            <div class="community-icon mb-3">
                                <i class="fas fa-balance-scale fa-3x text-warning"></i>
                            </div>
                            <h4 class="card-title text-light">Combat Discrimination</h4>
                            <p class="card-text text-muted">
                                Promoting equality and inclusion in our community through education, awareness, and action.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Anti-discrimination policies</li>
                                <li><i class="fas fa-check text-success me-2"></i>Diversity training programs</li>
                                <li><i class="fas fa-check text-success me-2"></i>Inclusive community guidelines</li>
                            </ul>
                            <a href="#" class="btn btn-warning">Join the Fight</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="impact-stats mt-5">
                <div class="row text-center">
                    <div class="col-md-3">
                        <div class="stat-item">
                            <h2 class="text-primary fw-bold">50K+</h2>
                            <p class="text-muted">Families Helped</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <h2 class="text-success fw-bold">$2M+</h2>
                            <p class="text-muted">Funds Raised</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <h2 class="text-warning fw-bold">100+</h2>
                            <p class="text-muted">Countries Reached</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <h2 class="text-info fw-bold">10K+</h2>
                            <p class="text-muted">Volunteers</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="get-involved-section mt-5 text-center">
                <h3 class="text-light mb-3">How You Can Help</h3>
                <p class="text-muted mb-4">Join our community of changemakers</p>
                <div class="row justify-content-center">
                    <div class="col-md-4">
                        <div class="action-card">
                            <i class="fas fa-hand-holding-heart fa-2x text-primary mb-3"></i>
                            <h5 class="text-light">Donate</h5>
                            <p class="text-muted">Support our community initiatives with a donation</p>
                            <a href="#" class="btn btn-outline-primary">Donate Now</a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="action-card">
                            <i class="fas fa-user-friends fa-2x text-success mb-3"></i>
                            <h5 class="text-light">Volunteer</h5>
                            <p class="text-muted">Join our volunteer network and make a direct impact</p>
                            <a href="#" class="btn btn-outline-success">Volunteer</a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="action-card">
                            <i class="fas fa-share-alt fa-2x text-info mb-3"></i>
                            <h5 class="text-light">Spread the Word</h5>
                            <p class="text-muted">Help us reach more people by sharing our mission</p>
                            <a href="#" class="btn btn-outline-info">Share</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .community-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .community-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        border-color: var(--primary-light);
    }

    .community-icon {
        transition: transform 0.3s ease;
    }

    .community-card:hover .community-icon {
        transform: scale(1.1);
    }

    .stat-item {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .stat-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-3px);
    }

    .action-card {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .action-card:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-5px);
        border-color: var(--primary-light);
    }
</style>

