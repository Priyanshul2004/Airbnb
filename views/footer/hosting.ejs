<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="hosting-header text-center mb-5">
                <h1 class="display-4 fw-bold text-light mb-3">
                    <i class="fas fa-home me-3"></i>Become a Host
                </h1>
                <p class="lead text-muted">
                    Turn your space into extra income and share your world with travelers.
                </p>
            </div>

            <div class="row g-4">
                <div class="col-lg-6 col-md-6">
                    <div class="hosting-card h-100">
                        <div class="card-body p-4">
                            <div class="hosting-icon mb-3">
                                <i class="fas fa-rocket fa-3x text-primary"></i>
                            </div>
                            <h4 class="card-title text-light">Try Hosting</h4>
                            <p class="card-text text-muted">
                                Start your hosting journey with our easy setup process and comprehensive support.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Easy listing creation</li>
                                <li><i class="fas fa-check text-success me-2"></i>Professional photography</li>
                                <li><i class="fas fa-check text-success me-2"></i>24/7 support</li>
                                <li><i class="fas fa-check text-success me-2"></i>Flexible hosting options</li>
                            </ul>
                            <a href="#" class="btn btn-primary">Start Hosting</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6">
                    <div class="hosting-card h-100">
                        <div class="card-body p-4">
                            <div class="hosting-icon mb-3">
                                <i class="fas fa-shield-alt fa-3x text-success"></i>
                            </div>
                            <h4 class="card-title text-light">AirCover</h4>
                            <p class="card-text text-muted">
                                Comprehensive protection for your property and peace of mind while hosting.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Property damage protection</li>
                                <li><i class="fas fa-check text-success me-2"></i>Liability insurance</li>
                                <li><i class="fas fa-check text-success me-2"></i>Income protection</li>
                                <li><i class="fas fa-check text-success me-2"></i>24/7 safety line</li>
                            </ul>
                            <a href="#" class="btn btn-success">Learn More</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6">
                    <div class="hosting-card h-100">
                        <div class="card-body p-4">
                            <div class="hosting-icon mb-3">
                                <i class="fas fa-book fa-3x text-info"></i>
                            </div>
                            <h4 class="card-title text-light">Hosting Resources</h4>
                            <p class="card-text text-muted">
                                Access guides, tips, and best practices to become a successful host.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Hosting guides</li>
                                <li><i class="fas fa-check text-success me-2"></i>Pricing strategies</li>
                                <li><i class="fas fa-check text-success me-2"></i>Guest communication</li>
                                <li><i class="fas fa-check text-success me-2"></i>Marketing tips</li>
                            </ul>
                            <a href="#" class="btn btn-info">View Resources</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6">
                    <div class="hosting-card h-100">
                        <div class="card-body p-4">
                            <div class="hosting-icon mb-3">
                                <i class="fas fa-comments fa-3x text-warning"></i>
                            </div>
                            <h4 class="card-title text-light">Community Forum</h4>
                            <p class="card-text text-muted">
                                Connect with other hosts, share experiences, and get advice from the community.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Host discussions</li>
                                <li><i class="fas fa-check text-success me-2"></i>Success stories</li>
                                <li><i class="fas fa-check text-success me-2"></i>Expert advice</li>
                                <li><i class="fas fa-check text-success me-2"></i>Local meetups</li>
                            </ul>
                            <a href="#" class="btn btn-warning">Join Forum</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="hosting-benefits mt-5">
                <div class="row text-center">
                    <div class="col-md-4">
                        <div class="benefit-item">
                            <i class="fas fa-dollar-sign fa-3x text-success mb-3"></i>
                            <h4 class="text-light">Extra Income</h4>
                            <p class="text-muted">Earn money from your unused space</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="benefit-item">
                            <i class="fas fa-globe fa-3x text-primary mb-3"></i>
                            <h4 class="text-light">Meet People</h4>
                            <p class="text-muted">Connect with travelers from around the world</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="benefit-item">
                            <i class="fas fa-clock fa-3x text-info mb-3"></i>
                            <h4 class="text-light">Flexible Schedule</h4>
                            <p class="text-muted">Host when it works for you</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="hosting-stats mt-5">
                <div class="row text-center">
                    <div class="col-md-3">
                        <div class="stat-item">
                            <h2 class="text-primary fw-bold">4M+</h2>
                            <p class="text-muted">Hosts Worldwide</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <h2 class="text-success fw-bold">$150B+</h2>
                            <p class="text-muted">Earned by Hosts</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <h2 class="text-warning fw-bold">220+</h2>
                            <p class="text-muted">Countries & Regions</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <h2 class="text-info fw-bold">1B+</h2>
                            <p class="text-muted">Guest Arrivals</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cta-section mt-5 text-center">
                <h3 class="text-light mb-3">Ready to Start Hosting?</h3>
                <p class="text-muted mb-4">Join millions of hosts who are earning extra income</p>
                <a href="#" class="btn btn-primary btn-lg me-3">Get Started</a>
                <a href="#" class="btn btn-outline-light btn-lg">Learn More</a>
            </div>
        </div>
    </div>
</div>

<style>
    .hosting-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .hosting-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        border-color: var(--primary-light);
    }

    .hosting-icon {
        transition: transform 0.3s ease;
    }

    .hosting-card:hover .hosting-icon {
        transform: scale(1.1);
    }

    .benefit-item {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .benefit-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-5px);
        border-color: var(--primary-light);
    }

    .stat-item {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .stat-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-3px);
    }
</style>

