<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="legal-header text-center mb-5">
                <h1 class="display-4 fw-bold text-light mb-3">
                    <i class="fas fa-gavel me-3"></i>Legal Information
                </h1>
                <p class="lead text-muted">
                    Important legal documents and policies that govern your use of UrbanNest.
                </p>
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="legal-card h-100">
                        <div class="card-body p-4">
                            <div class="legal-icon mb-3">
                                <i class="fas fa-shield-alt fa-3x text-primary"></i>
                            </div>
                            <h4 class="card-title text-light">Privacy Policy</h4>
                            <p class="card-text text-muted">
                                Learn how we collect, use, and protect your personal information.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Data collection practices</li>
                                <li><i class="fas fa-check text-success me-2"></i>Information sharing policies</li>
                                <li><i class="fas fa-check text-success me-2"></i>Your privacy rights</li>
                                <li><i class="fas fa-check text-success me-2"></i>Security measures</li>
                            </ul>
                            <a href="#" class="btn btn-primary">Read Privacy Policy</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="legal-card h-100">
                        <div class="card-body p-4">
                            <div class="legal-icon mb-3">
                                <i class="fas fa-file-contract fa-3x text-success"></i>
                            </div>
                            <h4 class="card-title text-light">Terms of Service</h4>
                            <p class="card-text text-muted">
                                Understand the terms and conditions for using our platform.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>User responsibilities</li>
                                <li><i class="fas fa-check text-success me-2"></i>Platform rules</li>
                                <li><i class="fas fa-check text-success me-2"></i>Service limitations</li>
                                <li><i class="fas fa-check text-success me-2"></i>Dispute resolution</li>
                            </ul>
                            <a href="#" class="btn btn-success">Read Terms</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="legal-card h-100">
                        <div class="card-body p-4">
                            <div class="legal-icon mb-3">
                                <i class="fas fa-cookie-bite fa-3x text-warning"></i>
                            </div>
                            <h4 class="card-title text-light">Cookie Policy</h4>
                            <p class="card-text text-muted">
                                Information about how we use cookies and similar technologies.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Cookie types we use</li>
                                <li><i class="fas fa-check text-success me-2"></i>Purpose of cookies</li>
                                <li><i class="fas fa-check text-success me-2"></i>Managing preferences</li>
                                <li><i class="fas fa-check text-success me-2"></i>Third-party cookies</li>
                            </ul>
                            <a href="#" class="btn btn-warning">Read Cookie Policy</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="legal-sections mt-5">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="legal-section">
                            <h4 class="text-light mb-3">
                                <i class="fas fa-user-shield me-2"></i>Your Rights
                            </h4>
                            <div class="rights-list">
                                <div class="right-item mb-3">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span class="text-light">Right to access your data</span>
                                </div>
                                <div class="right-item mb-3">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span class="text-light">Right to correct inaccurate information</span>
                                </div>
                                <div class="right-item mb-3">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span class="text-light">Right to delete your account</span>
                                </div>
                                <div class="right-item mb-3">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span class="text-light">Right to data portability</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="legal-section">
                            <h4 class="text-light mb-3">
                                <i class="fas fa-lock me-2"></i>Data Security
                            </h4>
                            <div class="security-list">
                                <div class="security-item mb-3">
                                    <i class="fas fa-shield-alt text-primary me-2"></i>
                                    <span class="text-light">End-to-end encryption</span>
                                </div>
                                <div class="security-item mb-3">
                                    <i class="fas fa-shield-alt text-primary me-2"></i>
                                    <span class="text-light">Regular security audits</span>
                                </div>
                                <div class="security-item mb-3">
                                    <i class="fas fa-shield-alt text-primary me-2"></i>
                                    <span class="text-light">Secure data centers</span>
                                </div>
                                <div class="security-item mb-3">
                                    <i class="fas fa-shield-alt text-primary me-2"></i>
                                    <span class="text-light">Access controls</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="compliance-section mt-5">
                <h3 class="text-light text-center mb-4">Compliance & Certifications</h3>
                <div class="row text-center">
                    <div class="col-md-3">
                        <div class="compliance-item">
                            <i class="fas fa-certificate fa-3x text-primary mb-3"></i>
                            <h5 class="text-light">GDPR Compliant</h5>
                            <p class="text-muted">European data protection</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="compliance-item">
                            <i class="fas fa-certificate fa-3x text-success mb-3"></i>
                            <h5 class="text-light">CCPA Compliant</h5>
                            <p class="text-muted">California privacy rights</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="compliance-item">
                            <i class="fas fa-certificate fa-3x text-warning mb-3"></i>
                            <h5 class="text-light">SOC 2 Type II</h5>
                            <p class="text-muted">Security controls</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="compliance-item">
                            <i class="fas fa-certificate fa-3x text-info mb-3"></i>
                            <h5 class="text-light">ISO 27001</h5>
                            <p class="text-muted">Information security</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-legal mt-5 text-center">
                <h3 class="text-light mb-3">Legal Questions?</h3>
                <p class="text-muted mb-4">Contact our legal team for any questions about our policies</p>
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="contact-method">
                            <i class="fas fa-envelope fa-2x text-primary mb-2"></i>
                            <h5 class="text-light">Legal Inquiries</h5>
                            <p class="text-muted">legal@urbannest.com</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="contact-method">
                            <i class="fas fa-user-shield fa-2x text-success mb-2"></i>
                            <h5 class="text-light">Privacy Officer</h5>
                            <p class="text-muted">privacy@urbannest.com</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="last-updated mt-5 text-center">
                <p class="text-muted">
                    <i class="fas fa-calendar-alt me-2"></i>
                    Last updated: December 2024
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .legal-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .legal-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        border-color: var(--primary-light);
    }

    .legal-icon {
        transition: transform 0.3s ease;
    }

    .legal-card:hover .legal-icon {
        transform: scale(1.1);
    }

    .legal-section {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        margin-bottom: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .right-item, .security-item {
        display: flex;
        align-items: center;
        padding: 0.5rem 0;
    }

    .compliance-item {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .compliance-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-5px);
        border-color: var(--primary-light);
    }

    .contact-method {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .contact-method:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-3px);
    }
</style>
