<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="company-header text-center mb-5">
                <h1 class="display-4 fw-bold text-light mb-3">
                    <i class="fas fa-building me-3"></i>About UrbanNest
                </h1>
                <p class="lead text-muted">
                    Learn more about our company, mission, and opportunities to join our team.
                </p>
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="company-card h-100">
                        <div class="card-body p-4">
                            <div class="company-icon mb-3">
                                <i class="fas fa-newspaper fa-3x text-primary"></i>
                            </div>
                            <h4 class="card-title text-light">Newsroom</h4>
                            <p class="card-text text-muted">
                                Stay updated with the latest news, announcements, and company updates from UrbanNest.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Company announcements</li>
                                <li><i class="fas fa-check text-success me-2"></i>Product updates</li>
                                <li><i class="fas fa-check text-success me-2"></i>Industry insights</li>
                                <li><i class="fas fa-check text-success me-2"></i>Press releases</li>
                            </ul>
                            <a href="#" class="btn btn-primary">Read News</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="company-card h-100">
                        <div class="card-body p-4">
                            <div class="company-icon mb-3">
                                <i class="fas fa-briefcase fa-3x text-success"></i>
                            </div>
                            <h4 class="card-title text-light">Careers</h4>
                            <p class="card-text text-muted">
                                Join our team and help us build the future of travel and hospitality.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Open positions</li>
                                <li><i class="fas fa-check text-success me-2"></i>Company culture</li>
                                <li><i class="fas fa-check text-success me-2"></i>Benefits & perks</li>
                                <li><i class="fas fa-check text-success me-2"></i>Remote opportunities</li>
                            </ul>
                            <a href="#" class="btn btn-success">View Jobs</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="company-card h-100">
                        <div class="card-body p-4">
                            <div class="company-icon mb-3">
                                <i class="fas fa-chart-line fa-3x text-warning"></i>
                            </div>
                            <h4 class="card-title text-light">Investors</h4>
                            <p class="card-text text-muted">
                                Information for investors, financial reports, and company performance metrics.
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-check text-success me-2"></i>Financial reports</li>
                                <li><i class="fas fa-check text-success me-2"></i>Investor relations</li>
                                <li><i class="fas fa-check text-success me-2"></i>Stock information</li>
                                <li><i class="fas fa-check text-success me-2"></i>Corporate governance</li>
                            </ul>
                            <a href="#" class="btn btn-warning">Investor Info</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="company-mission mt-5">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <h3 class="text-light mb-3">Our Mission</h3>
                        <p class="text-muted mb-4">
                            To create a world where anyone can belong anywhere, providing healthy travel that is local, authentic, diverse, inclusive and sustainable.
                        </p>
                        <div class="mission-points">
                            <div class="mission-point mb-3">
                                <i class="fas fa-globe text-primary me-3"></i>
                                <span class="text-light">Global Community</span>
                            </div>
                            <div class="mission-point mb-3">
                                <i class="fas fa-leaf text-success me-3"></i>
                                <span class="text-light">Sustainable Travel</span>
                            </div>
                            <div class="mission-point mb-3">
                                <i class="fas fa-heart text-danger me-3"></i>
                                <span class="text-light">Inclusive Experience</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mission-stats">
                            <div class="row text-center">
                                <div class="col-6">
                                    <div class="stat-item">
                                        <h3 class="text-primary fw-bold">220+</h3>
                                        <p class="text-muted">Countries</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="stat-item">
                                        <h3 class="text-success fw-bold">4M+</h3>
                                        <p class="text-muted">Hosts</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="stat-item">
                                        <h3 class="text-warning fw-bold">1B+</h3>
                                        <p class="text-muted">Guest Arrivals</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="stat-item">
                                        <h3 class="text-info fw-bold">100K+</h3>
                                        <p class="text-muted">Cities</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="leadership-section mt-5">
                <h3 class="text-light text-center mb-4">Leadership Team</h3>
                <div class="row">
                    <div class="col-lg-3 col-md-6">
                        <div class="leader-card text-center">
                            <div class="leader-avatar mb-3">
                                <i class="fas fa-user-circle fa-4x text-primary"></i>
                            </div>
                            <h5 class="text-light">CEO</h5>
                            <p class="text-muted">Leading our vision and strategy</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="leader-card text-center">
                            <div class="leader-avatar mb-3">
                                <i class="fas fa-user-circle fa-4x text-success"></i>
                            </div>
                            <h5 class="text-light">CTO</h5>
                            <p class="text-muted">Driving innovation and technology</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="leader-card text-center">
                            <div class="leader-avatar mb-3">
                                <i class="fas fa-user-circle fa-4x text-warning"></i>
                            </div>
                            <h5 class="text-light">CFO</h5>
                            <p class="text-muted">Managing financial operations</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="leader-card text-center">
                            <div class="leader-avatar mb-3">
                                <i class="fas fa-user-circle fa-4x text-info"></i>
                            </div>
                            <h5 class="text-light">CPO</h5>
                            <p class="text-muted">Shaping product experience</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-section mt-5 text-center">
                <h3 class="text-light mb-3">Get in Touch</h3>
                <p class="text-muted mb-4">Have questions about UrbanNest? We'd love to hear from you.</p>
                <div class="row justify-content-center">
                    <div class="col-md-4">
                        <div class="contact-method">
                            <i class="fas fa-envelope fa-2x text-primary mb-2"></i>
                            <h5 class="text-light">General Inquiries</h5>
                            <p class="text-muted">info@urbannest.com</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-method">
                            <i class="fas fa-briefcase fa-2x text-success mb-2"></i>
                            <h5 class="text-light">Careers</h5>
                            <p class="text-muted">careers@urbannest.com</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-method">
                            <i class="fas fa-chart-line fa-2x text-warning mb-2"></i>
                            <h5 class="text-light">Investor Relations</h5>
                            <p class="text-muted">investors@urbannest.com</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .company-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .company-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        border-color: var(--primary-light);
    }

    .company-icon {
        transition: transform 0.3s ease;
    }

    .company-card:hover .company-icon {
        transform: scale(1.1);
    }

    .mission-point {
        display: flex;
        align-items: center;
        padding: 0.5rem 0;
    }

    .stat-item {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .stat-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-3px);
    }

    .leader-card {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .leader-card:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-5px);
        border-color: var(--primary-light);
    }

    .contact-method {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .contact-method:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-3px);
    }
</style>
