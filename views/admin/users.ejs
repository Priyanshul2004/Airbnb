<% layout("/layouts/boilerplate") %>

<style>
  .admin-container {
    display: flex;
    min-height: 100vh;
    background: var(--bg-dark);
  }

  /* Hide footer in admin dashboard */
  footer {
    display: none !important;
  }

  /* Sidebar Styles */
  .admin-sidebar {
    width: 280px;
    background: var(--primary-color);
    padding: 0;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
    z-index: 1000;
  }

  .sidebar-header {
    padding: 30px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .sidebar-header h3 {
    color: var(--text-light);
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sidebar-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-menu li {
    margin: 0;
  }

  .sidebar-menu a {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px 20px;
    color: #cbd5e1;
    text-decoration: none;
    transition: all 0.3s ease;
    border-left: 3px solid transparent;
  }

  .sidebar-menu a:hover,
  .sidebar-menu li.active a {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    border-left-color: var(--accent-color);
  }

  .sidebar-menu i {
    width: 20px;
    text-align: center;
  }

  /* Main Content */
  .admin-main {
    flex: 1;
    margin-left: 280px;
    padding: 30px;
  }

  .page-header {
    margin-bottom: 30px;
  }

  .page-title {
    color: var(--text-light);
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 10px 0;
  }

  .page-subtitle {
    color: #94a3b8;
    font-size: 1.1rem;
    margin: 0;
  }

  /* Users Grid */
  .users-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .user-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(15px);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .user-card:hover {
    transform: translateY(-5px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.08));
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .user-header {
    padding: 25px 25px 20px 25px;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .user-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-color), #0891b2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 2rem;
    margin: 0 auto 15px auto;
    border: 3px solid rgba(255, 255, 255, 0.2);
  }

  .user-name {
    color: var(--text-light);
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 5px 0;
  }

  .user-email {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 0;
  }

  .user-content {
    padding: 20px 25px 25px 25px;
  }

  .user-details {
    margin-bottom: 20px;
  }

  .user-detail {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .user-detail i {
    width: 18px;
    color: var(--accent-color);
  }

  .user-type {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 15px;
  }

  .user-type.user {
    background: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
  }

  .user-type.admin {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
  }

  .user-actions {
    display: flex;
    gap: 10px;
  }

  .btn-delete {
    flex: 1;
    padding: 12px 16px;
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    text-align: center;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .btn-delete:hover {
    background: rgba(239, 68, 68, 0.3);
    color: #f87171;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
  }

  .btn-delete:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .btn-refresh {
    background: var(--primary-color);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .btn-refresh:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #94a3b8;
  }

  .empty-state i {
    font-size: 4rem;
    margin-bottom: 20px;
    color: var(--accent-color);
  }

  .empty-state h3 {
    color: var(--text-light);
    margin-bottom: 10px;
  }

  .empty-state p {
    margin-bottom: 30px;
  }

  /* Loading State */
  .loading {
    display: none;
    text-align: center;
    padding: 20px;
    color: var(--accent-color);
  }

  .loading i {
    font-size: 2rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .admin-sidebar {
      width: 100%;
      position: relative;
      height: auto;
    }

    .admin-main {
      margin-left: 0;
      padding: 20px;
    }

    .users-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="admin-container">
  <!-- Admin Sidebar -->
  <nav class="admin-sidebar">
    <div class="sidebar-header">
      <h3><i class="fas fa-crown"></i> Admin Panel</h3>
    </div>
    <ul class="sidebar-menu">
      <li>
        <a href="/admin/dashboard">
          <i class="fas fa-tachometer-alt"></i>
          <span>Dashboard</span>
        </a>
      </li>
      <li>
        <a href="/admin/listings">
          <i class="fas fa-home"></i>
          <span>Manage Listings</span>
        </a>
      </li>
      <li>
        <a href="/listings/new">
          <i class="fas fa-plus"></i>
          <span>Add New Listing</span>
        </a>
      </li>
      <li class="active">
        <a href="/admin/users">
          <i class="fas fa-users"></i>
          <span>Users</span>
        </a>
      </li>
      <li>
        <a href="/admin/profile">
          <i class="fas fa-user"></i>
          <span>Profile</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Main Content -->
  <main class="admin-main">
    <div class="page-header">
      <h1 class="page-title">User Management</h1>
      <p class="page-subtitle">Manage all registered users</p>
    </div>

    <div class="loading" id="loading">
      <i class="fas fa-spinner"></i>
      <p>Deleting user...</p>
    </div>

    <% if (users && users.length > 0) { %>
      <div class="users-grid">
        <% users.forEach(user => { %>
          <div class="user-card" id="user-<%= user._id %>">
            <div class="user-header">
              <div class="user-avatar">
                <%= user.username.charAt(0).toUpperCase() %>
              </div>
              <h3 class="user-name"><%= user.username %></h3>
              <p class="user-email"><%= user.email %></p>
            </div>
            
            <div class="user-content">
              <div class="user-type <%= user.userType %>">
                <%= user.userType %>
              </div>
              
              <div class="user-details">
                <% if (user.firstName || user.lastName) { %>
                  <div class="user-detail">
                    <i class="fas fa-user"></i>
                    <span><%= user.firstName || '' %> <%= user.lastName || '' %></span>
                  </div>
                <% } %>
                <div class="user-detail">
                  <i class="fas fa-calendar"></i>
                  <span>Joined: <%= user.createdAt ? user.createdAt.toLocaleDateString() : 'Unknown' %></span>
                </div>
                <div class="user-detail">
                  <i class="fas fa-clock"></i>
                  <span>Last updated: <%= user.updatedAt ? user.updatedAt.toLocaleDateString() : 'Unknown' %></span>
                </div>
              </div>

              <div class="user-actions">
                <button class="btn-delete" onclick="deleteUser('<%= user._id %>', '<%= user.username %>')">
                  <i class="fas fa-trash"></i> Delete User
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-users"></i>
        <h3>No Users Found</h3>
        <p>There are no registered users to display at the moment.</p>
      </div>
    <% } %>
  </main>
</div>

<script>
function deleteUser(userId, username) {
  if (confirm(`Are you sure you want to delete user "${username}"? This action cannot be undone and will also delete all their listings and reviews.`)) {
    // Show loading state
    document.getElementById('loading').style.display = 'block';
    
    // Disable all delete buttons
    const deleteButtons = document.querySelectorAll('.btn-delete');
    deleteButtons.forEach(btn => btn.disabled = true);
    
    fetch(`/admin/users/${userId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Remove the user card from the DOM
        const userCard = document.getElementById(`user-${userId}`);
        if (userCard) {
          userCard.style.transition = 'all 0.3s ease';
          userCard.style.opacity = '0';
          userCard.style.transform = 'scale(0.8)';
          setTimeout(() => {
            userCard.remove();
          }, 300);
        }
        
        // Show success message
        alert('User deleted successfully!');
      } else {
        alert('Error deleting user: ' + data.message);
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error deleting user. Please try again.');
    })
    .finally(() => {
      // Hide loading state
      document.getElementById('loading').style.display = 'none';
      
      // Re-enable delete buttons
      deleteButtons.forEach(btn => btn.disabled = false);
    });
  }
}

// Function to fetch users via API
async function fetchUsers() {
  try {
    console.log('📡 Fetching users from API...');
    const response = await fetch('/admin/api/users');
    const data = await response.json();
    
    if (data.success) {
      console.log(`✅ Successfully fetched ${data.count} users`);
      console.log('📋 Users data:', data.data);
      return data.data;
    } else {
      console.error('❌ API Error:', data.message);
      return [];
    }
  } catch (error) {
    console.error('❌ Network Error:', error);
    return [];
  }
}

// Function to refresh users
async function refreshUsers() {
  console.log('🔄 Refreshing users...');
  const users = await fetchUsers();
  
  if (users.length > 0) {
    console.log('✅ Users refreshed successfully');
    // You can add logic here to update the UI if needed
  } else {
    console.log('ℹ️ No users found');
  }
}

// Initialize page
document.addEventListener('DOMContentLoaded', function() {
  console.log('🎉 Admin users page initialized');
  
  // Add refresh button to page header
  const pageHeader = document.querySelector('.page-header');
  if (pageHeader) {
    const refreshBtn = document.createElement('button');
    refreshBtn.className = 'btn-refresh';
    refreshBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Refresh';
    refreshBtn.onclick = refreshUsers;
    pageHeader.appendChild(refreshBtn);
  }
});
</script>
