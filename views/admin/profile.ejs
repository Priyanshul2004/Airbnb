<% layout("/layouts/boilerplate") %>

<style>
  .admin-container {
    display: flex;
    min-height: 100vh;
    background: var(--bg-dark);
  }

  /* Hide footer in admin dashboard */
  footer {
    display: none !important;
  }

  /* Sidebar Styles */
  .admin-sidebar {
    width: 280px;
    background: var(--primary-color);
    padding: 0;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
    z-index: 1000;
  }

  .sidebar-header {
    padding: 30px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .admin-profile {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .admin-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 3px solid var(--accent-color);
    object-fit: cover;
  }

  .admin-info h4 {
    color: var(--text-light);
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .admin-info p {
    color: #94a3b8;
    margin: 5px 0 0 0;
    font-size: 0.9rem;
  }

  .sidebar-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-menu li {
    margin: 0;
  }

  .sidebar-menu a {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px 20px;
    color: #cbd5e1;
    text-decoration: none;
    transition: all 0.3s ease;
    border-left: 3px solid transparent;
  }

  .sidebar-menu a:hover,
  .sidebar-menu li.active a {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    border-left-color: var(--accent-color);
  }

  .sidebar-menu i {
    width: 20px;
    text-align: center;
  }

  /* Main Content */
  .main-content {
    flex: 1;
    margin-left: 280px;
    padding: 30px;
  }

  .page-header {
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .page-title {
    color: var(--text-light);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
  }

  .page-subtitle {
    color: var(--text-muted);
    font-size: 1rem;
    margin: 5px 0 0 0;
  }

  .profile-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .profile-section {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 15px;
    padding: 25px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
  }

  .section-title {
    color: var(--text-light);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 25px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-title i {
    color: var(--accent-color);
  }

  .profile-field {
    margin-bottom: 20px;
  }

  .field-label {
    display: block;
    color: #94a3b8;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .field-value {
    color: var(--text-light);
    font-size: 1rem;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .field-input-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .field-input {
    flex: 1;
    padding: 12px 15px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--text-light);
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .field-input:focus {
    outline: none;
    border-color: var(--accent-color);
    background: rgba(255, 255, 255, 0.08);
  }

  .field-input::placeholder {
    color: #64748b;
  }

  .btn-edit-field {
    padding: 12px;
    background: rgba(6, 182, 212, 0.2);
    border: 1px solid rgba(6, 182, 212, 0.3);
    border-radius: 8px;
    color: var(--accent-color);
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
  }

  .btn-edit-field:hover {
    background: rgba(6, 182, 212, 0.3);
    color: #60a5fa;
  }

  .btn-edit-field.saving {
    background: rgba(16, 185, 129, 0.2);
    border-color: rgba(16, 185, 129, 0.3);
    color: #10b981;
  }

  .btn-edit-field.error {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }

  .admin-type-badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .admin-type-badge.admin {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
  }

  .admin-type-badge.super_admin {
    background: rgba(168, 85, 247, 0.2);
    color: #a855f7;
  }

  .admin-type-badge.moderator {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
  }

  .profile-actions {
    margin-top: 30px;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .btn-edit-profile {
    display: inline-block;
    padding: 12px 25px;
    background: linear-gradient(135deg, var(--accent-color), var(--primary-light));
    color: white;
    text-decoration: none;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-edit-profile:hover {
    background: linear-gradient(135deg, #0891b2, #3b82f6);
    transform: translateY(-2px);
    color: white;
    text-decoration: none;
  }

  .account-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 20px;
    margin-top: 25px;
  }

  .stat-item {
    text-align: center;
    padding: 20px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stat-number {
    color: var(--accent-color);
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 5px;
  }

  .stat-label {
    color: #94a3b8;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .btn-refresh {
    background: var(--primary-color);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-refresh:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  /* Loading State */
  .loading {
    text-align: center;
    padding: 40px;
    color: var(--text-muted);
  }

  .loading i {
    font-size: 2rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .main-content {
      margin-left: 0;
      padding: 20px;
    }

    .admin-sidebar {
      display: none;
    }

    .profile-content {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .account-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<div class="admin-container">
  <!-- Admin Sidebar -->
  <nav class="admin-sidebar">
    <div class="sidebar-header">
      <div class="admin-profile">
        <div class="admin-avatar" id="sidebar-avatar">
          <!-- Avatar will be populated by JavaScript -->
        </div>
        <div class="admin-info">
          <h4 id="sidebar-name">Loading...</h4>
          <p id="sidebar-email">Loading...</p>
        </div>
      </div>
    </div>
    <ul class="sidebar-menu">
      <li>
        <a href="/admin/dashboard">
          <i class="fas fa-tachometer-alt"></i>
          <span>Dashboard</span>
        </a>
      </li>
      <li>
        <a href="/admin/listings">
          <i class="fas fa-home"></i>
          <span>Manage Listings</span>
        </a>
      </li>
      <li>
        <a href="/listings/new">
          <i class="fas fa-plus"></i>
          <span>Add New Listing</span>
        </a>
      </li>
      <li>
        <a href="/admin/users">
          <i class="fas fa-users"></i>
          <span>Users</span>
        </a>
      </li>
      <li class="active">
        <a href="/admin/profile">
          <i class="fas fa-user"></i>
          <span>Profile</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Main Content -->
  <main class="main-content">
    <div class="page-header">
      <div>
        <h1 class="page-title">Admin Profile</h1>
        <p class="page-subtitle">View and manage your admin account information</p>
      </div>
      <button class="btn-refresh" onclick="refreshProfile()">
        <i class="fas fa-sync-alt"></i> Refresh
      </button>
    </div>

    <div id="loading" class="loading">
      <i class="fas fa-spinner"></i>
      <p>Loading profile data...</p>
    </div>

    <div id="profile-content" class="profile-content" style="display: none;">
      <!-- Personal Information -->
      <div class="profile-section">
        <h2 class="section-title">
          <i class="fas fa-user-circle"></i>
          Personal Information
        </h2>

        <div class="profile-field">
          <label class="field-label">First Name</label>
          <div class="field-input-group">
            <input type="text" id="firstName" class="field-input" placeholder="Enter first name">
            <button class="btn-edit-field" onclick="editField('firstName')">
              <i class="fas fa-edit"></i>
            </button>
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Last Name</label>
          <div class="field-input-group">
            <input type="text" id="lastName" class="field-input" placeholder="Enter last name">
            <button class="btn-edit-field" onclick="editField('lastName')">
              <i class="fas fa-edit"></i>
            </button>
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Username</label>
          <div class="field-value" id="username">
            Loading...
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Email Address</label>
          <div class="field-input-group">
            <input type="email" id="email" class="field-input" placeholder="Enter email address">
            <button class="btn-edit-field" onclick="editField('email')">
              <i class="fas fa-edit"></i>
            </button>
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Phone Number</label>
          <div class="field-input-group">
            <input type="tel" id="phone" class="field-input" placeholder="Enter phone number">
            <button class="btn-edit-field" onclick="editField('phone')">
              <i class="fas fa-edit"></i>
            </button>
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Account Type</label>
          <div class="field-value">
            <span class="admin-type-badge" id="userType-badge">
              Loading...
            </span>
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Role</label>
          <div class="field-value">
            <span class="admin-type-badge" id="role-badge">
              Loading...
            </span>
          </div>
        </div>
      </div>

      <!-- Account Information -->
      <div class="profile-section">
        <h2 class="section-title">
          <i class="fas fa-info-circle"></i>
          Account Information
        </h2>

        <div class="profile-field">
          <label class="field-label">Admin ID</label>
          <div class="field-value" id="adminId">
            Loading...
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Account Status</label>
          <div class="field-value" id="accountStatus">
            Loading...
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Last Login</label>
          <div class="field-value" id="lastLogin">
            Loading...
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Member Since</label>
          <div class="field-value" id="memberSince">
            Loading...
          </div>
        </div>

        <div class="profile-field">
          <label class="field-label">Last Updated</label>
          <div class="field-value" id="lastUpdated">
            Loading...
          </div>
        </div>
      </div>

      <!-- Platform Statistics -->
      <div class="profile-section" style="grid-column: 1 / -1;">
        <h2 class="section-title">
          <i class="fas fa-chart-bar"></i>
          Platform Statistics
        </h2>

        <div class="account-stats">
          <div class="stat-item">
            <div class="stat-number" id="stat-listings">0</div>
            <div class="stat-label">Total Listings</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" id="stat-users">0</div>
            <div class="stat-label">Total Users</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" id="stat-reviews">0</div>
            <div class="stat-label">Total Reviews</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" id="stat-revenue">$0</div>
            <div class="stat-label">Total Revenue</div>
          </div>
        </div>
      </div>

      <!-- Profile Actions -->
      <div class="profile-actions" style="grid-column: 1 / -1;">
        <a href="#" class="btn-edit-profile" onclick="editProfile()">
          <i class="fas fa-edit"></i> Edit Profile
        </a>
      </div>
    </div>
  </main>
</div>

<script>
  console.log('🔍 === ADMIN PROFILE PAGE LOADED ===');

  // Function to fetch admin profile data via API
  async function fetchProfileData() {
    try {
      console.log('📡 Fetching admin profile data from API...');
      const response = await fetch('/admin/api/profile');
      const data = await response.json();
      
      if (data.success) {
        console.log('✅ Successfully fetched admin profile data');
        console.log('📋 Profile data:', data.data);
        return data.data;
      } else {
        console.error('❌ API Error:', data.message);
        return null;
      }
    } catch (error) {
      console.error('❌ Network Error:', error);
      return null;
    }
  }

  // Function to populate profile data
  function populateProfile(profileData) {
    console.log('🔄 Populating profile data...');
    
    // Sidebar info
    document.getElementById('sidebar-avatar').textContent = profileData.username.charAt(0).toUpperCase();
    document.getElementById('sidebar-name').textContent = profileData.username;
    document.getElementById('sidebar-email').textContent = profileData.email;
    
    // Personal Information
    document.getElementById('firstName').value = profileData.firstName || '';
    document.getElementById('lastName').value = profileData.lastName || '';
    document.getElementById('username').textContent = profileData.username;
    document.getElementById('email').value = profileData.email;
    document.getElementById('phone').value = profileData.phone || '';
    
    // Account badges
    document.getElementById('userType-badge').textContent = profileData.userType === 'admin' ? 'Administrator' : 'User';
    document.getElementById('userType-badge').className = `admin-type-badge ${profileData.userType}`;
    document.getElementById('role-badge').textContent = profileData.role;
    document.getElementById('role-badge').className = `admin-type-badge ${profileData.role}`;
    
    // Account Information
    document.getElementById('adminId').textContent = profileData.id;
    document.getElementById('accountStatus').textContent = profileData.isActive ? 'Active' : 'Inactive';
    document.getElementById('lastLogin').textContent = profileData.lastLogin ? 
      new Date(profileData.lastLogin).toLocaleDateString() : 'Never';
    document.getElementById('memberSince').textContent = profileData.createdAt ? 
      new Date(profileData.createdAt).toLocaleDateString() : 'Unknown';
    document.getElementById('lastUpdated').textContent = profileData.updatedAt ? 
      new Date(profileData.updatedAt).toLocaleDateString() : 'Unknown';
    
    // Statistics
    document.getElementById('stat-listings').textContent = profileData.stats.totalListings;
    document.getElementById('stat-users').textContent = profileData.stats.totalUsers;
    document.getElementById('stat-reviews').textContent = profileData.stats.totalReviews;
    document.getElementById('stat-revenue').textContent = '$' + profileData.stats.totalRevenue;
    
    console.log('✅ Profile data populated successfully');
  }

  // Function to refresh profile
  async function refreshProfile() {
    console.log('🔄 Refreshing profile...');
    
    // Show loading
    document.getElementById('loading').style.display = 'block';
    document.getElementById('profile-content').style.display = 'none';
    
    const profileData = await fetchProfileData();
    
    if (profileData) {
      populateProfile(profileData);
      document.getElementById('loading').style.display = 'none';
      document.getElementById('profile-content').style.display = 'grid';
      console.log('✅ Profile refreshed successfully');
    } else {
      document.getElementById('loading').innerHTML = '<i class="fas fa-exclamation-triangle"></i><p>Error loading profile data</p>';
      console.log('❌ Failed to refresh profile');
    }
  }

  // Function to edit field (placeholder)
  function editField(fieldName) {
    console.log(`✏️ Edit field clicked: ${fieldName}`);
    alert(`Edit ${fieldName} functionality will be implemented soon!`);
  }

  // Function to edit profile (placeholder)
  function editProfile() {
    console.log('✏️ Edit profile clicked');
    alert('Edit profile functionality will be implemented soon!');
  }

  // Initialize page
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🎉 Admin profile page initialized');
    refreshProfile();
  });
</script>